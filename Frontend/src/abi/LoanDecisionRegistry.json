{
  "contractName": "LoanDecisionRegistry",
  "abi": [
    {
      "type": "constructor",
      "inputs": [],
      "stateMutability": "nonpayable"
    },
    {
      "type": "function",
      "name": "decisionMaker",
      "inputs": [],
      "outputs": [{ "name": "", "type": "address", "internalType": "address" }],
      "stateMutability": "view"
    },
    {
      "type": "function",
      "name": "registerLoanApplication",
      "inputs": [{ "name": "_loanAmount", "type": "uint256", "internalType": "uint256" }],
      "outputs": [{ "name": "", "type": "uint256", "internalType": "uint256" }],
      "stateMutability": "nonpayable"
    },
    {
      "type": "function",
      "name": "getApplicationCounter",
      "inputs": [],
      "outputs": [{ "name": "", "type": "uint256", "internalType": "uint256" }],
      "stateMutability": "view"
    },
    {
      "type": "function",
      "name": "getApplicantApplications",
      "inputs": [{ "name": "_applicant", "type": "address", "internalType": "address" }],
      "outputs": [{ "name": "", "type": "uint256[]", "internalType": "uint256[]" }],
      "stateMutability": "view"
    },
    {
      "type": "function",
      "name": "getLoanApplication",
      "inputs": [{ "name": "_applicationId", "type": "uint256", "internalType": "uint256" }],
      "outputs": [
        { "name": "", "type": "uint256", "internalType": "uint256" },
        { "name": "", "type": "address", "internalType": "address" },
        { "name": "", "type": "uint256", "internalType": "uint256" },
        { "name": "", "type": "uint8",   "internalType": "enum LoanDecisionRegistry.LoanStatus" },
        { "name": "", "type": "uint256", "internalType": "uint256" }
      ],
      "stateMutability": "view"
    },
    {
      "type": "function",
      "name": "getApplicationSummary",
      "inputs": [{ "name": "_applicationId", "type": "uint256", "internalType": "uint256" }],
      "outputs": [
        { "name": "applicationId", "type": "uint256", "internalType": "uint256" },
        { "name": "applicant",     "type": "address",  "internalType": "address" },
        { "name": "loanAmount",    "type": "uint256",  "internalType": "uint256" },
        { "name": "status",        "type": "uint8",    "internalType": "enum LoanDecisionRegistry.LoanStatus" },
        { "name": "appliedAt",     "type": "uint256",  "internalType": "uint256" },
        { "name": "hasDecision",   "type": "bool",     "internalType": "bool" }
      ],
      "stateMutability": "view"
    },
    {
      "type": "function",
      "name": "getLoanApplicationStatus",
      "inputs": [{ "name": "_applicationId", "type": "uint256", "internalType": "uint256" }],
      "outputs": [{ "name": "", "type": "uint8", "internalType": "enum LoanDecisionRegistry.LoanStatus" }],
      "stateMutability": "view"
    },
    {
      "type": "function",
      "name": "applicationExists",
      "inputs": [{ "name": "_applicationId", "type": "uint256", "internalType": "uint256" }],
      "outputs": [{ "name": "", "type": "bool", "internalType": "bool" }],
      "stateMutability": "view"
    },
    {
      "type": "function",
      "name": "decisionExists",
      "inputs": [{ "name": "_loanId", "type": "uint256", "internalType": "uint256" }],
      "outputs": [{ "name": "", "type": "bool", "internalType": "bool" }],
      "stateMutability": "view"
    },
    {
      "type": "function",
      "name": "getMyLoanApplication",
      "inputs": [{ "name": "_applicationId", "type": "uint256", "internalType": "uint256" }],
      "outputs": [
        { "name": "", "type": "uint256", "internalType": "uint256" },
        { "name": "", "type": "address", "internalType": "address" },
        { "name": "", "type": "uint256", "internalType": "uint256" },
        { "name": "", "type": "uint8",   "internalType": "enum LoanDecisionRegistry.LoanStatus" },
        { "name": "", "type": "uint256", "internalType": "uint256" }
      ],
      "stateMutability": "view"
    },
    {
      "type": "function",
      "name": "recordLoanDecision",
      "inputs": [
        { "name": "_loanId",   "type": "uint256", "internalType": "uint256" },
        { "name": "_decision", "type": "string",  "internalType": "string" }
      ],
      "outputs": [],
      "stateMutability": "nonpayable"
    },
    {
      "type": "function",
      "name": "getLoanDecision",
      "inputs": [{ "name": "_loanId", "type": "uint256", "internalType": "uint256" }],
      "outputs": [
        { "name": "", "type": "uint256", "internalType": "uint256" },
        { "name": "", "type": "string",  "internalType": "string" },
        { "name": "", "type": "uint256", "internalType": "uint256" }
      ],
      "stateMutability": "view"
    },
    {
      "type": "event",
      "name": "LoanDecisionRecorded",
      "inputs": [
        { "name": "loanId",    "type": "uint256", "internalType": "uint256", "indexed": true },
        { "name": "decision",  "type": "string",  "internalType": "string",  "indexed": false },
        { "name": "timestamp", "type": "uint256", "internalType": "uint256", "indexed": false }
      ],
      "anonymous": false
    },
    {
      "type": "event",
      "name": "LoanApplicationSubmitted",
      "inputs": [
        { "name": "applicationId", "type": "uint256", "internalType": "uint256", "indexed": true },
        { "name": "applicant",     "type": "address",  "internalType": "address",  "indexed": true },
        { "name": "loanAmount",    "type": "uint256",  "internalType": "uint256",  "indexed": false },
        { "name": "timestamp",     "type": "uint256",  "internalType": "uint256",  "indexed": false }
      ],
      "anonymous": false
    },
    {
      "type": "event",
      "name": "LoanApplicationStatusUpdated",
      "inputs": [
        { "name": "applicationId", "type": "uint256", "internalType": "uint256", "indexed": true },
        { "name": "status",        "type": "uint8",   "internalType": "enum LoanDecisionRegistry.LoanStatus", "indexed": false },
        { "name": "timestamp",     "type": "uint256", "internalType": "uint256", "indexed": false }
      ],
      "anonymous": false
    }
  ]
}
