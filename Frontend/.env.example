# ──────────────────────────────────────────────────
# Environment Variables — Frontend
# Copy this file to .env and fill in the values.
# All variables MUST be prefixed with VITE_ to be
# exposed to the browser via import.meta.env.
# ──────────────────────────────────────────────────

# The deployed smart contract address on the target network
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# JSON-RPC endpoint for reading blockchain state (e.g. Alchemy, Infura, local Hardhat node)
VITE_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# ── Future variables (uncomment when needed) ──────

# Chain ID of the target network (1 = Ethereum mainnet, 11155111 = Sepolia, 31337 = local Hardhat)
# VITE_CHAIN_ID=11155111

# Block explorer base URL (for linking to transactions)
# VITE_EXPLORER_URL=https://sepolia.etherscan.io
