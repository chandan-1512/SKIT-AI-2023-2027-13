# ──────────────────────────────────────────────────
# Environment Variables — Frontend
# Copy this file to .env and fill in the values.
# All variables MUST be prefixed with VITE_ to be
# exposed to the browser via import.meta.env.
# ──────────────────────────────────────────────────

# The deployed smart contract address on the target network
# Sepolia deployment: 0xc7E21E406ECB753eD0b9caB836601057a0577eD8
VITE_CONTRACT_ADDRESS=0xc7E21E406ECB753eD0b9caB836601057a0577eD8

# JSON-RPC endpoint for reading blockchain state (e.g. Alchemy, Infura, local Hardhat node)
VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# ── Sprint 4 — Wallet & Chain config ──────────────

# Chain ID of the target network (11155111 = Sepolia, 31337 = local Hardhat)
# Sepolia is the primary target; 31337 is also accepted for local dev.
VITE_CHAIN_ID=11155111

# Block explorer base URL (for linking to transactions)
VITE_EXPLORER_URL=https://sepolia.etherscan.io

# AI model scoring endpoint (FastAPI) — used for "preview score" feature (Task 4)
# VITE_AI_SCORE_URL=http://localhost:8000/score
